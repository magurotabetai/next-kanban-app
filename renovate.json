{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": "before 2pm on Tuesday",
  "timezone": "Asia/Tokyo",
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "excludePackageNames": [
        "@libsql/client",
        "@prisma/client",
        "@prisma/adapter-libsql",
        "prisma"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "minor and patch dependencies"
    }
  ],
  "enabledManagers": [
    "npm"
  ]
}
